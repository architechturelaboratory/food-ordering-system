# ======================
# LOGGING
# ======================
LOG_LEVEL_COM_FOOD_ORDERING_SYSTEM=DEBUG

# ======================
# DATABASE
# ======================
DB_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=payment&binaryTransfer=true&reWriteBatchedInserts=true&stringtype=unspecified
DB_USERNAME=postgres
DB_PASSWORD=admin

# ======================
# KAFKA CORE
# ======================
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092
